{
  "name": "react-storykit",
  "version": "0.9.0",
  "description": "Modern headless & styled stories status component kit for React. Segmented status rings, interactive Instagram stickers, smooth dual-buffer transitions, and gestures.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/styles.css --minify",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "keywords": [
    "react",
    "storykit",
    "story",
    "stories",
    "status",
    "status-ring",
    "instagram-stories",
    "stickers",
    "viewer",
    "typescript",
    "tailwind"
  ],
  "author": "Infinitietechnologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinitietechnologies/StoryKit.git"
  },
  "bugs": {
    "url": "https://github.com/Infinitietechnologies/StoryKit/issues"
  },
  "homepage": "https://github.com/Infinitietechnologies/StoryKit#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.0.2",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
